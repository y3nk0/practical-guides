% onepager-style.sty - the shared look of the one-page cheat sheets.
% Usage:  \documentclass[10pt,a4paper]{article}
%         \usepackage{onepager-style}
%         \onepagermeta{<pdf title>}
% The body opens with \fontsize{..}{..}\selectfont: each sheet is tuned to
% fill exactly one A4 page, so that size stays per-document.
\ProvidesPackage{onepager-style}[2026/10/28 Practical guides: one-page sheet style]

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}
\RequirePackage{microtype}
\RequirePackage[a4paper,margin=0.8cm,top=0.8cm,bottom=0.6cm]{geometry}
\RequirePackage{xcolor}
\RequirePackage{amsmath,amssymb}
\RequirePackage{multicol}
\RequirePackage{enumitem}
\RequirePackage{array,tabularx,colortbl}
\RequirePackage{framed}
\RequirePackage{hyperref}

\RequirePackage{guide-palette}

\hypersetup{colorlinks=true,urlcolor=brandlight,linkcolor=brand,
  pdfauthor={Konstantinos Skianis}}
\urlstyle{sf}
\makeatletter
\g@addto@macro\UrlBreaks{\do\/\do\-\do\.\do\_\do\?\do\&\do\=\do\:\do\,}
\makeatother
\Urlmuskip=0mu plus 2mu\relax

\pagestyle{empty}
\setlength{\columnsep}{0.62cm}
\setlength{\columnseprule}{0.3pt}
\def\columnseprulecolor{\color{brandlight!40}}
\setlength{\parindent}{0pt}
\setlength{\parskip}{2.2pt}
\setlist[itemize]{leftmargin=0.85em,topsep=1pt,itemsep=1.1pt,parsep=0pt,
                  label=\textcolor{brandlight}{\tiny$\bullet$}}
\setlist[enumerate]{leftmargin=1.1em,topsep=1pt,itemsep=1.1pt,parsep=0pt}

\newcommand{\head}[1]{%
  \vspace{4.5pt}{\color{brand}\rule{\linewidth}{0.9pt}}\par\vspace{1.5pt}%
  {\bfseries\color{brand}\MakeUppercase{#1}}\par\vspace{2pt}}
\newcommand{\sub}[1]{\par\addvspace{2.6pt}\noindent{\bfseries\color{ink}#1}\ \ignorespaces}
\newcommand{\code}[1]{\texttt{#1}}
\newcommand{\lnk}[2]{\href{#1}{\color{brandlight}#2}}
\newcommand{\dt}{\,\textperiodcentered\,\allowbreak}

\newenvironment{flag}
 {\par\addvspace{2pt}\setlength{\FrameSep}{3pt}%
  \def\FrameCommand{{\color{accent}\vrule width 1.4pt}\hspace{4pt}}%
  \MakeFramed{\advance\hsize-\width \FrameRestore}\parindent=0pt\ignorespaces}
 {\par\endMakeFramed\addvspace{2pt}}

\newcommand{\onepagermeta}[1]{\hypersetup{pdftitle={#1}}}

